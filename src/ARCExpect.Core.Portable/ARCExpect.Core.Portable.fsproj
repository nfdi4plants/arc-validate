<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <FablePackageType>library</FablePackageType>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>nfdi4plants</Authors>
    <Description>Portable result and output contracts for ARC validation packages.</Description>
    <Summary>Framework-neutral ARC validation results and JSON, JUnit, and badge writers for .NET and Fable.</Summary>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>F#;FSharp;ARC;validation;results;JUnit;badge;fable-dotnet;fable-javascript;fable-python</PackageTags>
    <PackageProjectUrl>https://github.com/nfdi4plants/arc-validate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nfdi4plants/arc-validate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/RELEASE_NOTES.md"))</PackageReleaseNotes>
    <PackageVersion>0.1.0-preview.1</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Results.fs" />
    <Compile Include="ValidationSummary.fs" />
    <Compile Include="JUnit.fs" />
    <Compile Include="Badge.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="RELEASE_NOTES.md" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Fable.Package.SDK" Version="1.4.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Thoth.Json.Core" Version="[0.9.0]" />
    <PackageReference Include="ValidationPackage.Codecs" Version="[0.1.0-preview.1]" />
    <PackageReference Include="ValidationPackage.Model" Version="[0.1.0-preview.1]" />
  </ItemGroup>

</Project>
