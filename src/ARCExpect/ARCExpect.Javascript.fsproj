<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <DefineConstants>FABLE_COMPILER;FABLE_COMPILER_JAVASCRIPT;FABLE_COMPILER_TYPESCRIPT</DefineConstants>
  </PropertyGroup>

  <!-- Keep this portable source list in the same order in all three projects. -->
  <ItemGroup>
    <Compile Include="Results.fs" />
    <Compile Include="ValidationSummary.fs" />
    <Compile Include="ARCValidationPackage.fs" />
    <Compile Include="Setup.fs" />
    <Compile Include="Execution.fs" />
    <Compile Include="JUnit.fs" />
    <Compile Include="Badge.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Fable.Pyxpecto" Version="[2.0.0]" />
    <PackageReference Include="Fable.Python" Version="5.4.0" />
    <PackageReference Include="Thoth.Json.Core" Version="[0.9.0]" />
    <PackageReference Include="ValidationPackage.Codecs" Version="$(ValidationPackageCodecsPackageVersion)" />
    <PackageReference Include="ValidationPackage.Model" Version="$(ValidationPackageModelPackageVersion)" />
  </ItemGroup>

</Project>
