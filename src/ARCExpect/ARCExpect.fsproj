<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ARCExpect</PackageId>
    <AssemblyName>ARCExpect</AssemblyName>
    <RootNamespace>ARCExpect</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>nfdi4plants</Authors>
    <Description>Portable ARC validation package authoring, execution, result contracts, and output writers.</Description>
    <Summary>ARC validation package authoring, execution, results, writers, and .NET compatibility APIs for .NET and Fable.</Summary>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>F#;FSharp;ARC;validation;JUnit;badge;fable-dotnet;fable-javascript;fable-python</PackageTags>
    <PackageProjectUrl>https://github.com/nfdi4plants/arc-validate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nfdi4plants/arc-validate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/RELEASE_NOTES.md"))</PackageReleaseNotes>
    <PackageVersion>$(ARCExpectPackageVersion)</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DotNet\Runtime\CommandLine.fs" />
    <Compile Include="DotNet\Runtime\Frontmatter.fs" />
    <Compile Include="DotNet\Runtime\Exception.fs" />
    <Compile Include="Common\Arguments\PackageArguments.fs" />
    <Compile Include="Common\Results\Results.fs" />
    <Compile Include="Common\Results\ValidationSummary.fs" />
    <Compile Include="Common\Package\ARCValidationPackage.fs" />
    <Compile Include="Common\Package\Setup.fs" />
    <Compile Include="Common\Execution\Execution.fs" />
    <Compile Include="Common\Outputs\JUnit.fs" />
    <Compile Include="Common\Outputs\Badge.fs" />
    <Compile Include="Common\Outputs\OutputPipeline.fs" />
    <Compile Include="DotNet\Runtime\Payload.fs" />
    <Compile Include="DotNet\Runtime\OutputFileSystem.fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="DotNet\TopLevelAPI.fs" />
    <Compile Include="DotNet\StringValidationPattern.fs" />
    <Compile Include="DotNet\ParamCollection.fs" />
    <Compile Include="DotNet\CVExtensions.fs" />
    <Compile Include="DotNet\ErrorMessage.fs" />
    <Compile Include="DotNet\ARCExpect.fs" />
    <Compile Include="DotNet\ValidationFunctions.fs" />
    <Compile Include="DotNet\SpecificationValidation\V2_0_0_Draft.fs" />
    <Compile Include="DotNet\SpecificationValidation\SpecificationSelection.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="RELEASE_NOTES.md" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Fable.Pyxpecto" Version="[2.0.0]" />
    <PackageReference Include="Fable.Python" Version="5.4.0" />
    <PackageReference Include="Thoth.Json.Core" Version="[0.9.0]" />
    <!--
      Keep AVPR dependencies as exact package references. Even in a sibling
      checkout we intentionally test the artifact boundary, not AVPR source
      ProjectReferences. Directory.Build.props chooses the versions; the
      restore source comes from NuGet or the local-artifact workflow documented
      in README.md.
    -->
    <PackageReference Include="ValidationPackage.Codecs" Version="$(ValidationPackageCodecsPackageVersion)" />
    <PackageReference Include="ValidationPackage.Model" Version="$(ValidationPackageModelPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ARCTokenization" Version="[6.0.0]" />
    <PackageReference Include="FSharpAux" Version="[2.0.0]" />
  </ItemGroup>

</Project>
