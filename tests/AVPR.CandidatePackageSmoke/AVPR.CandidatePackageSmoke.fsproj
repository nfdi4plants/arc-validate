<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AVPRClient" Version="$(AVPRClientPackageVersion)" />
    <PackageReference Include="AVPRClient.Interop" Version="$(AVPRClientInteropPackageVersion)" />
    <PackageReference Include="ValidationPackage.Codecs" Version="$(ValidationPackageCodecsPackageVersion)" />
    <PackageReference Include="ValidationPackage.Model" Version="$(ValidationPackageModelPackageVersion)" />
  </ItemGroup>
</Project>